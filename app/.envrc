# SKUEL direnv loader — secrets out of the worktree.
#
# Loads:
#   1. ~/.config/skuel/secrets.env  → credentials (HF_API_TOKEN, NEO4J_PASSWORD,
#                                     SESSION_SECRET_KEY, FIREFLY_PAT_*, etc.)
#                                     This file is OUTSIDE the worktree by
#                                     design — `git add .` cannot stage it.
#   2. ./.env                       → non-secret project config (NEO4J_URI,
#                                     APP_PORT, INTELLIGENCE_TIER, VAULT_ROOT…)
#                                     Still gitignored; safe to commit by
#                                     accident only because the pre-commit
#                                     secret-scan would catch credential
#                                     patterns even if it ever happened.
#
# Both files are loaded if present; missing files emit a soft direnv warning
# rather than failing.  Run `direnv allow` after editing this file.
#
# Migration / first-time setup:
#   uv run python scripts/migrate_secrets_to_homedir.py
#
# See: app/scripts/git-hooks/README.md
#      app/docs/roadmap/done/secrets-out-of-worktree.md

dotenv_if_exists ~/.config/skuel/secrets.env
dotenv_if_exists ./.env
