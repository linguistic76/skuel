{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-commit-docs.sh",
            "if": "Bash(git commit*)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
