# =============================================================================
# SKUEL Environment Configuration
# =============================================================================
# Two-file convention (Stage 2 of secrets-out-of-worktree):
#
#   Credentials (passwords, API keys, signing secrets) live in:
#       ~/.config/skuel/secrets.env       (mode 0600, OUTSIDE any git worktree)
#
#   Non-secret config (URIs, ports, feature flags, paths) lives in:
#       app/.env                          (gitignored, but in-repo)
#
# Both files are auto-loaded by direnv via app/.envrc on `cd` into the project.
#
# Setup:    cp app/.env.example app/.env  → fill non-secrets there
#           mkdir -p ~/.config/skuel && chmod 700 ~/.config/skuel
#           $EDITOR ~/.config/skuel/secrets.env && chmod 600 it  → secrets there
#           cd app/ && direnv allow .
#
# Already have a legacy .env with credentials in it? Run:
#   uv run python scripts/migrate_secrets_to_homedir.py
#
# Below, lines marked [SECRET → ~/.config/skuel/secrets.env] belong in the
# homedir file, NOT here. They appear in this template only for inventory.
# Do NOT commit .env to version control.

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
SKUEL_ENVIRONMENT=local          # local | development | staging | production | test

# -----------------------------------------------------------------------------
# Neo4j Database
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password    # [SECRET → ~/.config/skuel/secrets.env]
NEO4J_DATABASE=neo4j
# NEO4J_MAX_CONNECTION_POOL_SIZE=50
# NEO4J_CONNECTION_TIMEOUT=30
# NEO4J_ENCRYPTED=false          # true for AuraDB (neo4j+s://)

# -----------------------------------------------------------------------------
# AI / LLM (required for INTELLIGENCE_TIER=full)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key    # [SECRET → ~/.config/skuel/secrets.env]
# Anthropic only used when LLMConfig.provider=anthropic (OpenAI is the default).
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key   # [SECRET → ~/.config/skuel/secrets.env]
INTELLIGENCE_TIER=full           # core ($0, analytics only) | full (analytics + AI)

# -----------------------------------------------------------------------------
# Embeddings (HuggingFace Inference API — bge-large-en-v1.5)
# -----------------------------------------------------------------------------
HF_API_TOKEN=hf_your-huggingface-token   # [SECRET → ~/.config/skuel/secrets.env]
# EMBEDDING_ENABLED=false
# EMBEDDING_VECTOR_SEARCH_ENABLED=false
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EMBEDDING_DIMENSION=1024
# EMBEDDING_VERSION=v2
# EMBEDDING_BATCH_SIZE=25

# -----------------------------------------------------------------------------
# Audio (Deepgram — voice journal transcription)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your-deepgram-key   # [SECRET → ~/.config/skuel/secrets.env]

# -----------------------------------------------------------------------------
# Session Security
# -----------------------------------------------------------------------------
# Persisted session signing key. Without this, dev mode generates a new random
# key on every restart (session.py), invalidating all logged-in sessions.
# Pin this to keep users logged in across restarts. Local-dev only — rotate
# before any production/staging deployment.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=    # [SECRET → ~/.config/skuel/secrets.env]
# SKUEL_DEFAULT_DEV_USER=user_mike                 # Auto-login user for local development

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO                                     # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Vault (Obsidian content source)
# -----------------------------------------------------------------------------
# VAULT_ROOT=/home/mike/0bsidian/skuel
# VAULT_ENABLED=true
# AUTO_SYNC_VAULT=true
# WATCH_VAULT=false
# SYNC_INTERVAL_MINUTES=30

# -----------------------------------------------------------------------------
# Cache (optional — in-memory by default)
# -----------------------------------------------------------------------------
# CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# Firefly III (finance — ADR-051)
# -----------------------------------------------------------------------------
# Firefly III replaces SKUEL's expense/budget/reporting module. Bring up with:
#   docker compose --profile finance up firefly firefly-db
# Then visit http://localhost:8081, register both users (personal + SKUEL),
# generate Personal Access Tokens (Profile → OAuth → Personal Access Tokens),
# and paste them below.
# IMPORTANT: Docker Compose's .env parser treats everything after = as the
# value — including inline "# comment" text. Keep comments on their own lines,
# never after the value.
#
# Inside-network URL used by the app container
FIREFLY_BASE_URL=http://firefly:8080
# MUST start with "base64:" prefix. Generate:
#   printf "base64:%s\n" "$(head -c 32 /dev/urandom | base64)"
FIREFLY_APP_KEY=    # [SECRET → ~/.config/skuel/secrets.env]
FIREFLY_DB_PASSWORD=firefly-local-dev   # [SECRET → ~/.config/skuel/secrets.env]
# Personal Access Token for Mike's personal Firefly user
FIREFLY_PAT_PERSONAL=    # [SECRET → ~/.config/skuel/secrets.env]
# Personal Access Token for the SKUEL business Firefly user
FIREFLY_PAT_SKUEL=    # [SECRET → ~/.config/skuel/secrets.env]
FIREFLY_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Stripe → Firefly sync (webhook)
# -----------------------------------------------------------------------------
# SKUEL listens at POST /webhooks/stripe and forwards revenue events into the
# SKUEL Firefly user account. Set STRIPE_WEBHOOK_SECRET to the signing secret
# from https://dashboard.stripe.com/webhooks (or `stripe listen` for local).
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=    # [SECRET → ~/.config/skuel/secrets.env]

# -----------------------------------------------------------------------------
# Test Accounts (for automated testing / curl)
# -----------------------------------------------------------------------------
# Used by scripts in scripts/dev and integration tests. Local-only credentials.
TEST_ADMIN_USERNAME=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=    # [SECRET → ~/.config/skuel/secrets.env]
TEST_USER_USERNAME=
TEST_USER_PASSWORD=    # [SECRET → ~/.config/skuel/secrets.env]
