#!/bin/bash
# SKUEL Development Command Runner
# =================================
# Quick access to common development commands
#
# Usage: ./dev <command>

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

case "$1" in
  format)
    echo -e "${GREEN}Formatting code...${NC}"
    uv run ruff format
    echo -e "${GREEN}✓ Formatting complete${NC}"
    ;;

  format-check)
    echo -e "${YELLOW}Checking formatting...${NC}"
    uv run ruff format --check
    ;;

  lint)
    echo -e "${YELLOW}Running linters...${NC}"
    failed=0
    uv run ruff check || failed=1
    uv run python scripts/lint_skuel.py --strict || failed=1
    if [ $failed -eq 1 ]; then
      echo -e "${RED}✗ Lint checks found issues${NC}"
      exit 1
    fi
    ;;

  lint-fix)
    echo -e "${GREEN}Auto-fixing lint issues...${NC}"
    uv run ruff check --fix
    uv run python scripts/lint_skuel.py --fix
    ;;

  quality)
    echo -e "${YELLOW}Running all quality checks...${NC}"
    uv run python scripts/run_quality_checks.py
    ;;

  quality-fix)
    echo -e "${GREEN}Running quality checks with auto-fix...${NC}"
    uv run python scripts/run_quality_checks.py --fix
    ;;

  pre-merge)
    bash scripts/pre_merge_check.sh "${@:2}"
    ;;

  typecheck-strict)
    echo -e "${YELLOW}Running pyright (opt-in strict type check)...${NC}"
    uv run pyright
    ;;

  deps|outdated)
    echo -e "${YELLOW}Checking for outdated direct dependencies...${NC}"
    echo ""
    uv tree --outdated --depth 1
    echo ""
    echo -e "${YELLOW}Intentional pins — DO NOT bump in a routine upgrade:${NC}"
    echo "  neo4j==5.26.0       conservative driver pin, Bolt-fwd-compat w/ calendar server (ADR-067 § 3)"
    echo "  deepgram-sdk<5.0.0  5.x+ is a breaking SDK rewrite (ADR-067 § Pins)"
    echo ""
    echo -e "Upgrade workflow: see ${GREEN}docs/decisions/ADR-067-dependency-upgrade-policy.md${NC}"
    ;;

  audit-routes)
    echo -e "${YELLOW}Auditing route security (CSRF + auth on mutation handlers)...${NC}"
    uv run python scripts/audit_route_security.py "${@:2}"
    ;;

  audit-deps)
    echo -e "${YELLOW}Auditing locked dependencies for known CVEs (osv-scanner, both ecosystems)...${NC}"
    bash scripts/audit_dependencies.sh
    ;;

  audit-graph-vocabulary)
    echo -e "${YELLOW}Auditing LIVE graph vocabulary against NeoLabel / RelationshipName / EntityType...${NC}"
    uv run python scripts/audit_graph_vocabulary.py "${@:2}"
    ;;

  bloat)
    echo -e "${YELLOW}Detecting bloat (unused code)...${NC}"
    uv run python scripts/detect_bloat.py "${@:2}"
    ;;

  bloat-events)
    echo -e "${YELLOW}Detecting unused events...${NC}"
    uv run python scripts/detect_bloat.py --events-only
    ;;

  bloat-methods)
    echo -e "${YELLOW}Detecting unused service methods...${NC}"
    uv run python scripts/detect_bloat.py --methods-only
    ;;

  test)
    echo -e "${GREEN}Running COMPREHENSIVE test suite (recommended)${NC}"
    uv run python scripts/run_tests.py comprehensive
    ;;

  test-all)
    echo -e "${YELLOW}Running COMPLETE test suite (all of tests/)${NC}"
    uv run python scripts/run_tests.py all
    ;;

  test-integration)
    echo -e "${GREEN}Running integration tests (fast)${NC}"
    uv run python scripts/run_tests.py integration
    ;;

  test-unit)
    echo -e "${GREEN}Running unit tests (fast CI tier)${NC}"
    uv run python scripts/run_tests.py unit
    ;;

  test-js)
    echo -e "${GREEN}Running JS tests (vitest, static/js/)${NC}"
    npm run test:js
    ;;

  test-quick)
    echo -e "${GREEN}Running quick smoke test${NC}"
    uv run python scripts/run_tests.py quick
    ;;

  smoke)
    echo -e "${GREEN}Running render smoke test (headless Chrome — catches client-side render hangs)${NC}"
    uv run python scripts/smoke_test.py
    ;;

  serve)
    echo -e "${GREEN}Starting SKUEL server...${NC}"
    uv run python main.py
    ;;

  vault-sync)
    echo -e "${GREEN}Running one-shot vault sync (in-process reconciler)...${NC}"
    uv run python scripts/vault_bridge_sync.py "${@:2}"
    ;;

  knowledge-health)
    # Status to stderr so `./dev knowledge-health --json` yields clean JSON on stdout.
    echo -e "${GREEN}Measuring knowledge-subgraph structural health (ADR-080)...${NC}" >&2
    uv run python scripts/knowledge_health_report.py "${@:2}"
    ;;

  eval-chunk-retrieval)
    # Status to stderr so `./dev eval-chunk-retrieval --json` yields clean JSON on stdout.
    echo -e "${GREEN}Running chunk-retrieval eval (hit@k over /search semantic boost)...${NC}" >&2
    uv run python scripts/eval_chunk_retrieval.py "${@:2}"
    ;;

  eval-askesis-draw)
    # Status to stderr so `./dev eval-askesis-draw --json` yields clean JSON on stdout.
    echo -e "${GREEN}Comparing Askesis chunk draws (intent filter vs thin-draw fallback)...${NC}" >&2
    uv run python scripts/eval_askesis_chunk_draw.py "${@:2}"
    ;;

  eval-intent-classification)
    # Status to stderr so `./dev eval-intent-classification --json` yields clean JSON on stdout.
    echo -e "${GREEN}Scoring Askesis intent classification across aggregation arms...${NC}" >&2
    uv run python scripts/eval_intent_classification.py "${@:2}"
    ;;

  embed-backfill)
    # Default mode ONLY fills embedding-NULL nodes — deliberately not --stale
    # (--stale requires embedding IS NOT NULL, so it would skip every missing
    # node while re-spending API money on the ones that already have vectors).
    echo -e "${GREEN}Backfilling missing embeddings (fills embedding-NULL nodes)...${NC}" >&2
    uv run python scripts/generate_embeddings_batch.py "${@:2}"
    ;;

  telemetry-retention)
    echo -e "${GREEN}Pruning unbounded-growth telemetry (ADR-080 Horizon 0)...${NC}" >&2
    uv run python scripts/telemetry_retention.py "${@:2}"
    ;;

  backfill-productivity-stamps)
    # One-shot: fills NULL first/last_completion_at on ProductivityAnalytics from
    # each user's completed-task history (never moves an existing stamp) and drops
    # the retired tasks_completed property — the count is derived at read now.
    echo -e "${GREEN}Backfilling ProductivityAnalytics completion stamps...${NC}" >&2
    uv run python scripts/backfill_productivity_completion_stamps.py "${@:2}"
    ;;

  backfill-form-audience)
    echo -e "${GREEN}Backfilling FormSubmission default audience...${NC}" >&2
    uv run python scripts/backfill_form_submission_audience.py "${@:2}"
    ;;

  deploy)
    bash scripts/deploy.sh "${@:2}"
    ;;

  css)
    echo -e "${GREEN}Watching CSS changes...${NC}"
    npm run css:watch
    ;;

  css-build)
    echo -e "${GREEN}Building CSS...${NC}"
    npm run css:build
    ;;

  css-prod)
    echo -e "${GREEN}Building minified CSS for production...${NC}"
    npm run css:prod
    ;;

  health)
    echo -e "${YELLOW}Running codebase health checks...${NC}"
    echo ""
    failed=0
    uv run python scripts/health/dead_modules.py || failed=1
    echo ""
    uv run python scripts/health/dead_doc_links.py || failed=1
    echo ""
    uv run python scripts/health/stale_names.py || failed=1
    echo ""
    uv run python scripts/health/duplicate_headings.py || failed=1
    echo ""
    uv run python scripts/health/docs_updated.py || failed=1
    echo ""
    uv run python scripts/validate_cross_references.py || failed=1
    echo ""
    if [ $failed -eq 1 ]; then
      echo -e "${RED}✗ Health check found issues — review output above${NC}"
      exit 1
    else
      echo -e "${GREEN}✓ All health checks passed${NC}"
    fi
    ;;

  health-modules)
    echo -e "${YELLOW}Checking for dead Python modules...${NC}"
    uv run python scripts/health/dead_modules.py
    ;;

  health-links)
    echo -e "${YELLOW}Checking for broken documentation links...${NC}"
    uv run python scripts/health/dead_doc_links.py
    ;;

  health-names)
    echo -e "${YELLOW}Checking for stale/deprecated names in docs...${NC}"
    uv run python scripts/health/stale_names.py "${@:2}"
    ;;

  health-headings)
    echo -e "${YELLOW}Checking for duplicate Markdown headings...${NC}"
    uv run python scripts/health/duplicate_headings.py "${@:2}"
    ;;

  health-updated)
    echo -e "${YELLOW}Checking docs \`updated:\` frontmatter stamps...${NC}"
    uv run python scripts/health/docs_updated.py "${@:2}"
    ;;

  health-xref)
    echo -e "${YELLOW}Validating skill↔doc cross-references...${NC}"
    uv run python scripts/validate_cross_references.py
    ;;

  health-mypy)
    # Deliberately NOT part of `./dev health` — one mypy run per (block, code)
    # pair puts this at ~80s, and a fast target that grows a slow tail stops
    # being run. See the script docstring for the full placement reasoning.
    echo -e "${YELLOW}Auditing mypy suppressions that suppress nothing...${NC}"
    uv run python scripts/health/mypy_suppressions.py "${@:2}"
    ;;

  docs-check)
    echo -e "${YELLOW}Running post-commit docs check...${NC}"
    echo '{"tool_input":{"command":"git commit"},"tool_response":"simulated"}' | bash .claude/hooks/post-commit-docs.sh | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('additionalContext','No suggestions.'))" 2>/dev/null || echo "Hook not available"
    ;;

  up)
    echo -e "${GREEN}Starting Neo4j + App...${NC}"
    shift
    docker compose up "$@"
    ;;

  up-monitoring)
    echo -e "${GREEN}Starting Neo4j + App + Prometheus + Grafana...${NC}"
    shift
    docker compose --profile monitoring up "$@"
    ;;

  up-neo4j)
    echo -e "${GREEN}Starting Neo4j only (for local dev with uv run python main.py)...${NC}"
    docker compose up neo4j -d
    ;;

  down)
    echo -e "${YELLOW}Stopping all services...${NC}"
    shift
    docker compose down "$@"
    ;;

  install-hooks)
    echo -e "${GREEN}Installing git hooks...${NC}"
    repo_root=$(git rev-parse --show-toplevel)
    if [[ -z "$repo_root" ]]; then
      echo "Not inside a git repo." >&2
      exit 1
    fi
    ln -sfv "../../app/scripts/git-hooks/pre-commit" "$repo_root/.git/hooks/pre-commit"
    echo "Hooks installed. Bypass once with: SKUEL_ALLOW_SECRETS=1 git commit ..."
    ;;

  help|*)
    echo "SKUEL Development Commands"
    echo "=========================="
    echo ""
    echo "Code Quality:"
    echo "  ./dev format         - Auto-format all Python files with Ruff"
    echo "  ./dev format-check   - Check formatting without changes"
    echo "  ./dev lint           - Run all linters (Ruff + SKUEL patterns)"
    echo "  ./dev lint-fix       - Auto-fix linting issues"
    echo "  ./dev quality        - Run ALL quality checks (format + lint + patterns + Cypher + skills)"
    echo "  ./dev quality-fix    - Run quality checks with auto-fix"
    echo "  ./dev pre-merge <PR#> - Verify PR is ready to merge (CI Gate + Codex + Kody)"
    echo "  ./dev audit-routes   - Audit @rt handlers for CSRF + auth gaps (--form-only, --verbose)"
    echo "  ./dev audit-deps     - Audit locked deps for known CVEs (osv-scanner, py+js; same as CI)"
    echo "  ./dev audit-graph-vocabulary - Audit LIVE graph labels/edges/entity_types vs the enums"
    echo ""
    echo "Bloat Detection:"
    echo "  ./dev bloat          - Detect all unused code (events + methods); --ready = READY PLANNED entries only"
    echo "  ./dev bloat-events   - Detect unused events only"
    echo "  ./dev bloat-methods  - Detect unused service methods only"
    echo ""
    echo "Health Checks:"
    echo "  ./dev health         - Run all health checks (modules + links + names + headings + updated + xref)"
    echo "  ./dev health-modules - Find Python files with zero importers"
    echo "  ./dev health-links   - Find broken links in docs/ and .claude/skills/"
    echo "  ./dev health-names   - Find stale/deprecated identifiers in doc code blocks"
    echo "  ./dev health-headings - Find repeated headings under one parent in docs"
    echo "  ./dev health-updated - Find docs whose \`updated:\` stamp has rotted or is missing"
    echo "  ./dev health-xref    - Validate skill↔doc cross-references and staleness"
    echo "  ./dev health-mypy    - Find mypy suppressions that suppress nothing (~80s, not in health)"
    echo ""
    echo "Testing:"
    echo "  ./dev test              - unit + integration + infrastructure [RECOMMENDED]"
    echo "  ./dev test-all          - Everything under tests/ (needs Docker)"
    echo "  ./dev test-integration  - Integration tests (local Docker Neo4j)"
    echo "  ./dev test-unit         - Unit tests — fast CI tier (no Docker) [FASTEST]"
    echo "  ./dev test-js           - JS tests — vitest over static/js/ (npm run test:js)"
    echo "  ./dev test-quick        - Quick smoke subset (integration + auth + errors)"
    echo ""
    echo "Dependencies:"
    echo "  ./dev deps                    - List outdated direct deps + intentional pins (alias: outdated)"
    echo ""
    echo "Documentation:"
    echo "  ./dev docs-check      - Check if docs need updating (runs post-commit hook)"
    echo ""
    echo "Docker:"
    echo "  ./dev up             - Start Neo4j + App (monitoring excluded by default)"
    echo "  ./dev up-monitoring  - Start Neo4j + App + Prometheus + Grafana"
    echo "  ./dev up-neo4j       - Start Neo4j only (then: uv run python main.py)"
    echo "  ./dev down           - Stop all Docker services"
    echo ""
    echo "Deployment:"
    echo "  ./dev deploy         - rsync + rebuild + health-gate the droplet stack (--content | --dry-run)"
    echo ""
    echo "Setup:"
    echo "  ./dev install-hooks  - Install git pre-commit hook (secret-leak guard)"
    echo ""
    echo "Development:"
    echo "  ./dev serve          - Start development server (requires Neo4j running)"
    echo "  ./dev smoke          - Render smoke test (headless Chrome; catches client-side render hangs)"
    echo "  ./dev vault-sync     - One-shot vault sync via reconciler (--vault content | --user <uid> | --force | --preview = dry run)"
    echo "  ./dev knowledge-health - Knowledge-subgraph structural-health report (ADR-080; --json)"
    echo "  ./dev embed-backfill - Fill missing embeddings (embedding-NULL nodes; needs OPENAI_API_KEY)"
    echo "  ./dev eval-chunk-retrieval - hit@k eval of /search chunk retrieval (FULL tier; --json)"
    echo "  ./dev eval-askesis-draw - Askesis chunk-draw arms: intent filter vs thin-draw (FULL tier; --json)"
    echo "  ./dev eval-intent-classification - Askesis intent classification: labelled set × aggregation arms (FULL tier; --json)"
    echo "  ./dev telemetry-retention - Prune unbounded-growth telemetry (ADR-080 H0; --dry-run | --days N)"
    echo "  ./dev backfill-productivity-stamps - Fill NULL ProductivityAnalytics completion stamps + drop the retired count (census by default; --confirm to write)"
    echo "  ./dev backfill-form-audience - Share pre-gate FormSubmissions with their submitter's groups (--dry-run first; --confirm to write)"
    echo "  ./dev css            - Watch and rebuild CSS on changes"
    echo "  ./dev css-build      - Build CSS once"
    echo "  ./dev css-prod       - Build minified CSS for production"
    echo ""
    echo "Examples:"
    echo "  ./dev format            # Before committing changes"
    echo "  ./dev quality-fix       # Fix all auto-fixable issues"
    echo "  ./dev test              # Comprehensive tests (recommended)"
    echo "  ./dev test-quick        # Fast smoke test (30s)"
    echo "  ./dev bloat-events      # Find unused events"
    echo ""
    echo "Advanced Test Options:"
    echo "  uv run python scripts/run_tests.py --help  # See all test runner options"
    ;;
esac
