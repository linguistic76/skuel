# k8s-secrets.yml.example
# ========================
# NEVER apply this file directly. It contains placeholder values that will
# allow session forgery and data exposure if used in production.
#
# Usage:
#   1. Copy to k8s-secrets.yml  (gitignored — never commit it)
#   2. Replace every "your-*" value with a real secret (see commands below)
#   3. Apply in order (namespace must exist before the Secret can be created):
#      kubectl apply -f k8s-manifests.yml
#      kubectl apply -f k8s-secrets.yml
#
# Generating secrets:
#   SESSION_SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"
#   JWT_SECRET:         python -c "import secrets; print(secrets.token_urlsafe(64))"
#   ENCRYPTION_KEY:     openssl rand -base64 32
#   NEO4J_PASSWORD:     openssl rand -base64 32
#   REDIS_PASSWORD:     openssl rand -base64 32
#   OPENAI_API_KEY:     (from platform.openai.com)
#   ANTHROPIC_API_KEY:  (from console.anthropic.com)

apiVersion: v1
kind: Secret
metadata:
  name: skuel-secrets
  namespace: skuel-production
type: Opaque
stringData:
  NEO4J_PASSWORD: "your-neo4j-password"
  REDIS_PASSWORD: "your-redis-password"
  SESSION_SECRET_KEY: "your-session-secret-key"
  JWT_SECRET: "your-jwt-secret"
  ENCRYPTION_KEY: "your-encryption-key"
  OPENAI_API_KEY: "your-openai-key"
  ANTHROPIC_API_KEY: "your-anthropic-key"
