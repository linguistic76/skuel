filters:
  and:
    - file.folder == "roadmap"
    - file.ext == "md"
    - file.basename != "deferred-work"
properties:
  file.name:
    displayName: Case file
  status:
    displayName: Status
  registered:
    displayName: Registered
  ruled:
    displayName: Ruled
  trigger:
    displayName: Trigger
  check:
    displayName: Check
views:
  - type: table
    name: Linked from the MOC
    filters:
      and:
        - file("roadmap/deferred-work.md").hasLink(file)
    order:
      - file.name
      - status
      - registered
      - ruled
      - trigger
      - check
  - type: table
    name: Live roadmap docs by status
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - registered
      - trigger
      - check
