{
  "uid": "skuel-event-bus",
  "title": "SKUEL Event Bus",
  "description": "Event bus publication rate, handler latency, and error tracking",
  "tags": ["skuel", "events", "performance"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Event Bus Activity",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Event Publication Rate",
      "description": "Domain events published per second",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "targets": [
        {
          "expr": "sum(rate(skuel_events_published_total[1m]))",
          "refId": "A",
          "legendFormat": "Events/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "unit": "ops"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Event Handler Performance",
      "description": "p95 event handler execution time",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(skuel_event_handler_duration_seconds_bucket[1m])) by (le))",
          "refId": "A",
          "legendFormat": "p95 handler duration"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          },
          "unit": "s"
        }
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"}
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Summary Stats",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "collapsed": false
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Events Published (1h)",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 10},
      "targets": [
        {
          "expr": "sum(increase(skuel_events_published_total[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Event Handler Calls (1h)",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 10},
      "targets": [
        {
          "expr": "sum(increase(skuel_event_handler_calls_total[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Event Handler Errors (1h)",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 10},
      "targets": [
        {
          "expr": "sum(increase(skuel_event_handler_errors_total[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    }
  ]
}
