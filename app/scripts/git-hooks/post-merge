#!/bin/bash
#
# SKUEL Post-Merge Hook - Library Change Detection
#
# This hook runs after git pull/merge completes.
# It detects PyPI package version changes and suggests which skills may need review.
#
# See: @docs-skills-evolution for the Library Upgrade Workflow
#      app/scripts/git-hooks/README.md for the hook set and how it is installed

set -e

# Colors
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Git runs hooks with CWD at the worktree root, but pyproject.toml and the
# detection script live in the app/ subdir. Resolve the app dir from this
# hook's own location (<app>/scripts/git-hooks/post-merge) so `uv run` and the
# script path both resolve. realpath, so a legacy .git/hooks symlink resolves
# to the canonical script rather than to the link's own directory.
HOOK_PATH="$(realpath "${BASH_SOURCE[0]:-$0}")"
APP_DIR="$(cd "$(dirname "$HOOK_PATH")/../.." && pwd)"
cd "$APP_DIR" || exit 0

# Only run if uv.lock changed
if git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD | grep -q "uv.lock"; then
    echo ""
    echo -e "${YELLOW}🔍 Detecting library changes...${NC}"

    # Run detection script
    uv run python scripts/detect_library_changes.py --from-ref ORIG_HEAD || true
fi

exit 0
