# SKUEL infrastructure direnv loader — secrets out of the worktree.
#
# Loads:
#   1. ~/.config/skuel/secrets.env  → credentials consumed by docker-compose
#                                     (NEO4J_AUTH). This file is OUTSIDE the
#                                     worktree by design — `git add .` cannot
#                                     stage it.
#   2. ./.env                       → non-secret infra config (heap sizes,
#                                     data dir, plugin toggles).
#
# Both files are loaded if present; missing files emit a soft direnv warning
# rather than failing.  Run `direnv allow` after editing this file.
#
# Workflow:
#   cd infrastructure          # direnv exports vars into the shell
#   docker compose up neo4j    # compose interpolates ${NEO4J_AUTH} etc.

dotenv_if_exists ~/.config/skuel/secrets.env
dotenv_if_exists ./.env
