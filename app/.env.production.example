# =============================================================================
# SKUEL Production (Droplet) Environment Configuration
# =============================================================================
# Copy to `.env.production` on the droplet (next to docker-compose.production.yml
# — NOT committed, NOT synced by ./dev deploy). Non-secret config only.
#
# SECRETS live in a separate file: /opt/skuel/secrets.env, mode 0600, loaded by
# the compose `env_file` list. Headless shape — no keychain on the droplet;
# get_credential() falls back to the process environment. Required there:
#
#   NEO4J_PASSWORD       AuraDB instance password
#   OPENAI_API_KEY       required at INTELLIGENCE_TIER=full (LLM + embeddings)
#   DEEPGRAM_API_KEY     required at INTELLIGENCE_TIER=full (transcription)
#   SESSION_SECRET_KEY   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Optional per-feature secrets (only when the feature is on):
#
#   RESEND_API_KEY          required when EMAIL_ENABLED=true below
#   ANTHROPIC_API_KEY       only when LLMConfig.provider=anthropic
#   STRIPE_WEBHOOK_SECRET   only when the Stripe webhook is in use
#
# Do NOT put secrets in this file — it is plain droplet config.

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# `production` turns on the boot guards: encrypted NEO4J_URI scheme required,
# session cookies https_only, rate limiting on.
# (docker-compose.production.yml also pins this inline as a hard invariant.)
SKUEL_ENVIRONMENT=production

# FULL tier = analytics + AI. Boot FAILS FAST without OPENAI_API_KEY and
# DEEPGRAM_API_KEY in secrets.env — that is correct behavior, not a bug:
# FULL-tier dependencies are required, never silently degraded.
INTELLIGENCE_TIER=full

# -----------------------------------------------------------------------------
# Neo4j — AuraDB Free
# -----------------------------------------------------------------------------
# Production requires an encrypted scheme (neo4j+s:// | bolt+s:// |
# neo4j+ssc:// | bolt+ssc://) — boot refuses plaintext. AuraDB is neo4j+s://.
# Startup tolerates a paused/waking Free instance (bounded connect retry).
NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
# NEO4J_PASSWORD → /opt/skuel/secrets.env

# -----------------------------------------------------------------------------
# Public URL / TLS (Caddy)
# -----------------------------------------------------------------------------
# Absolute origin used in outbound links (password-reset emails).
APP_URL=https://skuel.app

# Caddy site + ACME registration (read by the caddy container from this file).
# SKUEL_DOMAIN=localhost enables a full local rehearsal via Caddy's internal CA.
SKUEL_DOMAIN=skuel.app
ACME_EMAIL=you@example.com

# Uvicorn trusts X-Forwarded-* only from these sources (IPs or CIDRs,
# comma-separated). Caddy is the only other container on the compose network;
# Docker's default address pools live under 172.16.0.0/12.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# -----------------------------------------------------------------------------
# Signup gate
# -----------------------------------------------------------------------------
# When set, registration requires this invite code (constant-time check before
# any account is created). Unset = open signup. Recommended ON at launch —
# the real throttle on AuraDB Free node-cap growth and LLM-cost abuse.
SIGNUP_INVITE_CODE=choose-a-code

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Public-facing deployment needs password-reset email. When true, boot fails
# fast without RESEND_API_KEY in secrets.env.
EMAIL_ENABLED=true
RESEND_FROM_EMAIL=noreply@skuel.app

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Vaults — container paths (host side lives under /opt/skuel, see the volume
# mounts in docker-compose.production.yml)
# -----------------------------------------------------------------------------
# Content vault (curriculum; synced by `./dev deploy --content`, mounted :ro).
INGESTION_PATH=/app/content-vault
# Primary personal vault (owner-bound) + per-user roots.
VAULT_ROOT=/app/personal-vault
SKUEL_USER_VAULTS_ROOT=/app/data/user_vaults
# Personal vaults are server-local files on the droplet (ADR-075 Stage 1).
VAULT_TRANSPORT=filesystem
# Owner binding for VAULT_ROOT (ADR-070 Decision 5).
SKUEL_PERSONAL_VAULT_OWNER=user_mike
SKUEL_DEFAULT_USER_UID=user_mike
