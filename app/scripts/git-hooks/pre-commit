#!/usr/bin/env bash
# SKUEL pre-commit hook — block accidental secret leaks.
#
# Catches:
#   1. .env / .env.local / .env.<anything> files staged for commit (allows
#      .env.example and .env.sample).
#   2. High-confidence secret patterns in added lines (OpenAI, AWS, Stripe,
#      GitHub PAT, HuggingFace).
#
# Bypass (legitimate test fixtures, etc.):  SKUEL_ALLOW_SECRETS=1 git commit ...
#
# Install:  ln -sf ../../app/scripts/git-hooks/pre-commit .git/hooks/pre-commit
# Or use:   ./dev install-hooks  (from the app/ directory)

set -uo pipefail

if [[ "${SKUEL_ALLOW_SECRETS:-0}" == "1" ]]; then
  echo "pre-commit: SKUEL_ALLOW_SECRETS=1 set — skipping secret scan." >&2
  exit 0
fi

red() { printf '\033[31m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*"; }

fail=0

# --- Check 1: refuse .env-shaped files ------------------------------------
staged_files=$(git diff --cached --name-only --diff-filter=ACMR)
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  case "$(basename "$path")" in
    .env.example|.env.sample) ;;
    .env|.env.*)
      red "✗ Refusing to commit env file: $path"
      fail=1
      ;;
  esac
done <<< "$staged_files"

# --- Check 2: scan added lines for known secret shapes --------------------
# Use -U0 so we get only changed lines with no surrounding context.
diff_text=$(git diff --cached -U0 --diff-filter=ACMR -- ':(exclude)*.lock' ':(exclude)*.lock.json')

# Each pattern is provider + regex. Length thresholds are tuned to avoid
# matching short placeholders like `sk-proj-...` in docs.
patterns=(
  'OpenAI key|sk-(proj|live|test|or)-[A-Za-z0-9_-]{40,}'
  'AWS access key|\bAKIA[0-9A-Z]{16}\b'
  'Stripe webhook secret|\bwhsec_[A-Za-z0-9]{30,}\b'
  'Stripe live key|\bsk_live_[A-Za-z0-9]{20,}\b'
  'GitHub PAT|\bghp_[A-Za-z0-9]{36}\b'
  'GitHub fine-grained PAT|\bgithub_pat_[A-Za-z0-9_]{60,}\b'
  'HuggingFace token|\bhf_[A-Za-z0-9]{30,}\b'
  'Slack token|\bxox[abprs]-[A-Za-z0-9-]{20,}\b'
  'Google API key|\bAIza[0-9A-Za-z_-]{35}\b'
  'Private key block|-----BEGIN (RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----'
)

# Only inspect added lines (start with `+` but not `+++`).
added_lines=$(printf '%s\n' "$diff_text" | grep -E '^\+[^+]' || true)

for entry in "${patterns[@]}"; do
  label="${entry%%|*}"
  regex="${entry#*|}"
  matches=$(printf '%s\n' "$added_lines" | grep -E -- "$regex" || true)
  if [[ -n "$matches" ]]; then
    red "✗ Possible $label in staged changes:"
    # Show match locations without echoing the secret in full — print the
    # filename + line marker, redact long matches.
    printf '%s\n' "$matches" | sed -E -e 's/'"$regex"'/[REDACTED]/g' | head -5 | sed 's/^/    /' >&2
    fail=1
  fi
done

if [[ $fail -ne 0 ]]; then
  echo
  yellow "Commit blocked. If this is a false positive (test fixture, doc placeholder, etc.):"
  yellow "  SKUEL_ALLOW_SECRETS=1 git commit ..."
  yellow "If a real key was about to be committed: rotate it now and unstage."
  exit 1
fi

exit 0
