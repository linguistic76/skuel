"""Types for the fastcore.basics names first-party code reads."""

from typing import Any

class NotStr:
    """Behaves like a `str` (attributes delegate to it), but is not one: rendered unescaped."""

    s: str
    def __init__(self, s: str | NotStr) -> None: ...
    def __add__(self, b: object) -> NotStr: ...
    def __mul__(self, b: int) -> NotStr: ...
    def __len__(self) -> int: ...
    def __lt__(self, b: str) -> bool: ...
    def __bool__(self) -> bool: ...
    def __getattr__(self, k: str) -> Any: ...

# Every name this stub does not declare stays Any, explicitly.
def __getattr__(name: str) -> Any: ...
