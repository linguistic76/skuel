#!/usr/bin/env bash
# Pull SKUEL secrets from the OS keychain, then exec the given command
# with those secrets in its environment.
#
# Why this exists
# ---------------
# After Stage 3 of the secrets-out-of-worktree work
# (app/docs/roadmap/done/secrets-out-of-worktree.md), credentials live in the
# OS keychain. Python code is fine — get_credential() talks to the keychain
# via the KeyringBackend. But tools that read environment variables and
# can't speak to the keychain themselves get stuck:
#
#   - Docker Compose's `${NEO4J_PASSWORD}` interpolation in compose.yml
#   - psql / redis-cli / curl --header "Authorization: ..."
#   - One-off shell invocations of project scripts that you started outside
#     the direnv-loaded shell
#
# This helper bridges the gap. It reads the keyring index file maintained
# by KeyringBackend (`~/.config/skuel/keyring-index.json`), fetches each
# stored credential from the OS keychain, exports them as env vars, then
# exec's your command. Credentials exist only in the spawned process tree
# — no temp file on disk, no leak into the parent shell.
#
# Usage
# -----
#   ./scripts/dev/with-secrets docker compose up -d
#   ./scripts/dev/with-secrets psql "$DATABASE_URL"
#   ./scripts/dev/with-secrets env | grep NEO4J_  # inspect what's injected
#
# Set WITH_SECRETS_VERBOSE=1 to log the count of injected credentials.
#
# Requirements
# ------------
# - `uv` on PATH (used to run a Python interpreter with the project's
#   `keyring` dep available — no second venv required).
# - SKUEL_CREDENTIAL_BACKEND=keyring has been migrated to (run
#   `scripts/migrate_secrets_to_keychain.py` first).

set -euo pipefail

if [[ $# -eq 0 ]]; then
  cat >&2 <<'USAGE'
Usage: with-secrets <command> [args...]

Pulls every secret indexed at ~/.config/skuel/keyring-index.json out of the
OS keychain, exports them as environment variables, and exec's <command>.

Examples:
  with-secrets docker compose up
  with-secrets psql "$DATABASE_URL"
  with-secrets env | grep NEO4J_       # inspect what would be injected

Set WITH_SECRETS_VERBOSE=1 for a one-line summary of how many credentials
were injected.
USAGE
  exit 1
fi

# Hand off to a short Python program that does the keychain reads and
# then execvps the user's command. We use `uv run python` so the project's
# `keyring` dep is available without the user having to activate a venv.
# The `- "$@"` form makes the heredoc Python's stdin script while passing
# the rest of argv through unchanged.
exec uv run python - "$@" <<'PY'
import json
import os
import sys
from pathlib import Path

import keyring

INDEX = Path.home() / ".config" / "skuel" / "keyring-index.json"
SERVICE = "skuel"

injected = 0
if INDEX.exists():
    try:
        keys = json.loads(INDEX.read_text())
    except (OSError, json.JSONDecodeError) as e:
        print(f"with-secrets: failed to read keyring index: {e}", file=sys.stderr)
        keys = []
    for k in keys:
        try:
            v = keyring.get_password(SERVICE, k)
        except Exception as e:  # noqa: BLE001 — keyring backends raise broadly
            print(f"with-secrets: keychain lookup failed for {k}: {e}", file=sys.stderr)
            continue
        if v is not None:
            os.environ[k] = v
            injected += 1
else:
    print(
        f"with-secrets: no keyring index at {INDEX}.\n"
        f"  Have you run scripts/migrate_secrets_to_keychain.py?\n"
        f"  Running command anyway, with no credentials injected.",
        file=sys.stderr,
    )

if os.environ.get("WITH_SECRETS_VERBOSE"):
    print(f"with-secrets: injected {injected} credential(s)", file=sys.stderr)

# When invoked as `python - arg1 arg2 ...`, sys.argv == ['-', 'arg1', 'arg2', ...]
if len(sys.argv) < 2:
    print("with-secrets: no command given after secret injection", file=sys.stderr)
    sys.exit(1)

os.execvp(sys.argv[1], sys.argv[1:])
PY
